# chboot restore image script
#
# parse additional boot parameters outside functions
# to create global vars

export CHB_EFI=
export CHB_DEV=
export CHB_GRUB=
export ROOT_DEV=
export CHB_DIR=
export CHB_IMG_DIR=
export CHB_FLAGS=
export CHB_DATA_DIR="/data"
export CHB_URL=""
export CHB_ROOT_UUID=""
export CHB_IMG_BASE="chboot-image"
export CHB_IMG_NAME=""
export CHB_IMG_FILE=""
export CHB_IMG_EXTS="zst gz xz"
export chbmnt="/chboot"
export efimnt="/boot/efi"
export CHB_NCURSES=""
export CHB_MODE="restore"

# Parse chboot specific command line options
# outside functions to create global vars
for x in $(cat /proc/cmdline); do
        case $x in
        chb.efi=*) 
                CHB_EFI=${x#chb.efi=}
                ;;
        chb.dev=*) 
                CHB_DEV=${x#chb.dev=}
                ;;
        chb.dir=*) 
                CHB_DIR=${x#chb.dir=}
                ;;
        chb.grub=*) 
                CHB_GRUB=${x#chb.grub=}
                ;;
        chb.url=*) 
                CHB_URL=${x#chb.url=}
                ;;
        chb.imgname=*) 
                CHB_IMG_NAME=${x#chb.imgname=}
                ;;
        chb.imgdir=*) 
                CHB_IMG_DIR=${x#chb.imgdir=}
                ;;
        chb.uuid=*) 
                CHB_ROOT_UUID=${x#chb.uuid=}
                ;;
        chb.savepart) 
                CHB_MODE="save"
                ;;
        chb.ncurses) 
                CHB_NCURSES="-N"
                ;;
        esac
done

for v in "$CHB_EFI" "$CHB_DEV" "$CHB_DIR" "$CHB_ROOT_UUID" "$CHB_IMG_DIR" ; do
	[ "${v}" ] || panic "Boot arguments must include chb.uuid=, chb.efi=, chb.dev= chb.dir= and chb.imgdir= parameters. Dropping to a shell!"
done

chboot_reboot(){
#	TODO: find a better way to do this task ...
#	      kexec from kexec-tools ???

	echo b >/proc/sysrq-trigger
}

local_top()
{
	if [ "${local_top_used}" != "yes" ]; then
		[ "${quiet?}" != "y" ] && log_begin_msg "Running /scripts/local-top"
		run_scripts /scripts/local-top
		[ "$quiet" != "y" ] && log_end_msg
	fi
	local_top_used=yes
}

local_block()
{
	[ "${quiet?}" != "y" ] && log_begin_msg "Running /scripts/local-block"
	run_scripts /scripts/local-block "$@"
	[ "$quiet" != "y" ] && log_end_msg
}

chboot_premount()
{
	if [ "${chboot_premount_used}" != "yes" ]; then
		[ "${quiet?}" != "y" ] && log_begin_msg "Running /scripts/chboot-premount"
		run_scripts /scripts/chboot-premount
		[ "$quiet" != "y" ] && log_end_msg
	fi
	for d in $chbmnt $efimnt ; do
		[ -d "$d" ] || mkdir -p -m 0700 "$d"
	done
	chboot_premount_used=yes
}

chboot_bottom(){
	return
}

# $1=device ID to mount
# $2=optionname (for root and etc)
# $3=panic if device is missing (true or false, default: true)
# Sets $DEV to the resolved device node
local_device_setup()
{
	local dev_id="$1"
	local name="$2"
	local may_panic="${3:-true}"
	local real_dev
	local time_elapsed
	local count

	# If wait-for-root understands this prefix, then use it to wait for
	# the device rather than settling the whole of udev.

	# Timeout is max(30, rootdelay) seconds (approximately)
	local slumber=30
	case $DPKG_ARCH in
		powerpc|ppc64|ppc64el)
			slumber=180
			;;
		*)
			slumber=30
			;;
	esac
	if [ "${ROOTDELAY:-0}" -gt $slumber ]; then
		slumber=$ROOTDELAY
	fi

	case "$dev_id" in
	UUID=*|LABEL=*|PARTUUID=*|/dev/*)
		FSTYPE=$( wait-for-root "$dev_id" "$slumber" )
		;;
	*)
		wait_for_udev 10
		;;
	esac

	# Load ubi with the correct MTD partition and return since fstype
	# doesn't work with a char device like ubi.
	if [ -n "$UBIMTD" ]; then
		/sbin/modprobe ubi "mtd=$UBIMTD"
		DEV="${dev_id}"
		return
	fi

	# Don't wait for a device that doesn't have a corresponding
	# device in /dev and isn't resolvable by blkid (e.g. mtd0)
	if [ "${dev_id#/dev}" = "${dev_id}" ] &&
	   [ "${dev_id#*=}" = "${dev_id}" ]; then
		DEV="${dev_id}"
		return
	fi

	# If the root device hasn't shown up yet, give it a little while
	# to allow for asynchronous device discovery (e.g. USB).  We
	# also need to keep invoking the local-block scripts in case
	# there are devices stacked on top of those.
	#
	# in Ubuntu, we should never actually enter this loop as wait-for-root
	# above should have waited until the device appeared.
	if ! real_dev=$(resolve_device "${dev_id}") ||
	   ! get_fstype "${real_dev}" >/dev/null; then
		log_begin_msg "Waiting for ${name}"

		while true; do
			sleep 1
			time_elapsed="$(time_elapsed)"

			local_block "${dev_id}"

			# If mdadm's local-block script counts the
			# number of times it is run, make sure to
			# run it the expected number of times.
			mdadm_exec=0
			while true; do
				if [ -f /run/count.mdadm.initrd ]; then
					count="$(cat /run/count.mdadm.initrd)"
				elif [ -n "${count}" ]; then
					# mdadm script deleted it; put it back
					count=$((count + 1))
					echo "${count}" >/run/count.mdadm.initrd
				else
					break
				fi
				if [ "${count}" -ge "${time_elapsed}" ]; then
					break;
				fi

				# Track that mdadm was executed to force
				# cryptroot execution after the loop, see
				# LP #1879980.
				mdadm_exec=1
				/scripts/local-block/mdadm "${dev_id}"

				# Cryptroot must run here, see LP #1879980.
				# The counter is inc/dec on cryptroot script!
				if [ -f /run/cryptroot.initrd.cnt ]; then
					crypt_cnt=$(cat /run/cryptroot.initrd.cnt)
					if [ "${crypt_cnt}" -gt 0 ]; then
						/scripts/local-block/cryptroot "${dev_id}"
					fi
				fi
			done

			# Extra cryptroot run after mdadm loop in order to
			# start encrypted volumes on top of RAID arrays.
			if [ -f /run/cryptroot.initrd.cnt ]; then
				crypt_cnt=$(cat /run/cryptroot.initrd.cnt)
				if [ "${crypt_cnt}" -gt 0 ] || [ ${mdadm_exec} -ne 0 ]; then
					/scripts/local-block/cryptroot "${dev_id}"
				fi
			fi

			if real_dev=$(resolve_device "${dev_id}") &&
			   get_fstype "${real_dev}" >/dev/null; then
				wait_for_udev 10
				log_end_msg 0
				break
			fi
			if [ "${time_elapsed}" -ge "${slumber}" ]; then
				log_end_msg 1 || true
				break
			fi
		done
	fi

	# We've given up, but we'll let the user fix matters if they can
	while ! real_dev=$(resolve_device "${dev_id}") ||
	      ! get_fstype "${real_dev}" >/dev/null; do
		if ! $may_panic; then
			echo "Gave up waiting for ${name}"
			return 1
		fi
		echo "Gave up waiting for ${name} device.  Common problems:"
		echo " - Boot args (cat /proc/cmdline)"
		echo "   - Check rootdelay= (did the system wait long enough?)"
		if [ "${name}" = root ]; then
			echo "   - Check root= (did the system wait for the right device?)"
		fi
		echo " - Missing modules (cat /proc/modules; ls /dev)"
		panic "ALERT!  ${dev_id} does not exist.  Dropping to a shell!"
	done

	DEV="${real_dev}"
}

chboot_gzip(){
	gzip > "$1"
}

chboot_compression_cmd(){
	IMAGE_NAME="$1"
	COMPRESS_MODE="$2"
	CTYPE="$(echo "$IMAGE_NAME" |sed -e "s%\.parts$%%;s%^.*\.%%")"
	case "$CTYPE" in
		gz)
			CMD="chboot_gzip"
			UNCMD="gzip -cd"
			;;
		xz)
			CMD="xz -9e -c"
			#UNCMD="xz --decompress -c"
			UNCMD="xzcat"
			;;
		*)
			# default is zstd
			CMD="zstd -19 -T0"
			#UNCMD="zstd -dcf"
			UNCMD="zstdcat"
		;;
	esac
	if [ "$COMPRESS_MODE" = "compress" ]; then
		echo "$CMD"
	else
		echo "$UNCMD"
	fi		
}

chboot_get_image(){
	CHB_IMG_LIST=""
	CHB_IMG_FILE=""
	if [ "$CHB_URL" ] ; then
		# try to configure networking
		configure_networking
		# TODO: detect if network is up
		CHB_IMG_FILE="$CHB_URL"
	else
		if [ "$CHB_IMG_NAME" ] ; then
			CHB_IMG_LIST="${CHB_IMG_NAME}"
		else
			for t in $CHB_IMG_EXTS ; do
				CHB_IMG_LIST="$CHB_IMG_LIST ${CHB_IMG_BASE}.${t}"
			done
		fi
		for f in $CHB_IMG_LIST ; do
			F="${chbmnt}/${CHB_IMG_DIR}/${f}"
			[ ! -r "$F" ] || CHB_IMG_FILE="$F"
		done
	fi
	echo "$CHB_IMG_FILE"
}


chboot_save_image(){
	rc=0
	if [ -z "$CHB_IMG_NAME" ] ; then
		# first image extesion act as default
		DEF_IMG_EXT="$(echo "$CHB_IMG_EXTS" |sed -e "s%\s.*$%%")"
		CHB_IMG_NAME="${CHB_IMG_BASE}.${DEF_IMG_EXT}"
	fi
	IMG_DIR="${chbmnt}/${CHB_IMG_DIR}"
	mkdir -p "$IMG_DIR"
	CHB_IMG_FILE="${IMG_DIR}/${CHB_IMG_NAME}"
	ROOT="$1"
	# Get root filesystem type
	ROOTFSTYPE="$(get_fstype "${ROOT}")"
	PARTCLONE_CMD="partclone.$ROOTFSTYPE"
	if echo "$ROOTFSTYPE" |grep -q "^ext[[:digit:]]" ; then
		PARTCLONE_CMD="partclone.extfs"
	fi
	which "$PARTCLONE_CMD" || panic "Filesystem $ROOTFSTYPE not supported!"
	
	#DONE: Determine compression type and use apropiate tool
	#COMPRESS_CMD="zstd -19 -T0"
	COMPRESS_CMD="$(chboot_compression_cmd "$CHB_IMG_FILE" "compress")"

	$PARTCLONE_CMD $CHB_NCURSES -c -s $ROOT |$COMPRESS_CMD > "$CHB_IMG_FILE" || rc=$?
	return $rc
}

chboot_restore(){
	rc=0
	IMAGE_FILE="$1"
	DEST_PART="$2"
	# preserve root partition UUID
	# this is not required now, we are using CHB_ROOT_UUID
	# DEST_UUID="$(lsblk -nplo UUID $DEST_PART)"
	DEST_UUID="$CHB_ROOT_UUID"
	CAT_CMD="cat"
	#DONE: 1. Determine compression type and use apropiate tool
	#TODO: 2. Improve URL detection
	#UNCOMPRESS_CMD="zstdcat -"
	UNCOMPRESS_CMD="$(chboot_compression_cmd "$IMAGE_FILE" "uncompress")"

	if echo "$IMAGE_FILE" |grep -q "^http[s]\?:" ; then
		CAT_CMD="wget -O -"
	fi
	
	echo "TERM: $TERM"
	$CAT_CMD "$IMAGE_FILE" |$UNCOMPRESS_CMD |partclone.restore $CHB_NCURSES -I -C -d -s - -o $DEST_PART || rc=$?

	#clean and resize
	[ $rc -ne 0 ] || e2fsck -f $DEST_PART || rc=$?
	[ $rc -ne 0 ] || resize2fs $DEST_PART || rc=$?

	#restore UUID
	[ $rc -ne 0 ] || echo "y" |tune2fs -f -U "$DEST_UUID" "$DEST_PART" || rc=$?
	return $rc
}

chboot_mount_root(){
	local_top
	chboot_premount

	[ "${quiet?}" != "y" ] && log_begin_msg "Starting chboot partition setup"

	# get chboot device
	local_device_setup "${CHB_DEV}" "chboot file system"
	CHB_DEV="${DEV}"

	# Get the filesystem type
	[ "${quiet?}" != "y" ] && log_begin_msg "Getting chboot partition FS type"
	CHB_FSTYPE=$(get_fstype "${CHB_DEV}")

	roflag=-w
	# mount with write permissions all the needed dirs

	[ "${quiet?}" != "y" ] && log_begin_msg "Checking chboot partition filesystem"
	checkfs "${CHB_DEV}" chboot "${CHB_FSTYPE}"

	# Mount chboot
	[ "${quiet?}" != "y" ] && log_begin_msg "Mounting chboot partition"
	mount ${roflag} -t "${CHB_FSTYPE}" ${CHB_FLAGS} "${CHB_DEV}" "${chbmnt?}"
	mountchboot_status="$?"
	[ $mountchboot_status -eq 0 ] || panic "Error mounting chboot partition!"
	[ "${quiet?}" != "y" ] && log_begin_msg "Getting chboot image file"

	# get ROOT device
	if [ -z "${ROOT}" ]; then
                panic "No root device specified. Boot arguments must include a root= parameter."
        fi
        local_device_setup "${ROOT}" "root file system"
        ROOT="${DEV}"

	# create log dir (partclone requires this directory)
	mkdir -p /var/log

	if [ "$CHB_MODE" = "save" ] ; then
		chboot_save_image "$ROOT" || panic "Error restoring image file!!!"
		echo ""
		echo "$ROOT partition saved as $CHB_IMG_FILE"
		echo "Press [ENTER] to reboot"
		read a
		chboot_reboot
	fi

	# restore mode
	CHB_IMG_FILE="$(chboot_get_image)"
	[ "$CHB_IMG_FILE" ] || panic "chboot image file not found"

	chboot_restore "$CHB_IMG_FILE" "$ROOT" || panic "Error restoring image file!!!"

	# Get root filesystem type and mount root
	ROOTFSTYPE="$(get_fstype "${ROOT}")"
	mount ${roflag} -t "${ROOTFSTYPE}"  ${ROOTFLAGS} "${ROOT}" "${rootmnt?}"
       	mountroot_status="$?"
       	[ $mountroot_status -eq 0 ] || panic "Error mounting root partition!"

	# Mount efi partition
       	local_device_setup "${CHB_EFI}" "EFI partition"
       	CHB_EFI="${DEV}"
	EFI_FSTYPE="$(get_fstype "${CHB_EFI}")"
	mount ${roflag} -t "${EFI_FSTYPE}" ${EFI_FLAGS} "${CHB_EFI}" "${efimnt?}"
	mountefi_status="$?"
	[ $mountefi_status -eq 0 ] || panic "Error mounting EFI partition!"
	
	# if not explicit CHB_GRUB parameter is included,
	# install grub in the 'parent' device of the root partition
	
	if [ -z "$CHB_GRUB" ] ; then
	        # get 'parent' from ROOT
	        CHB_GRUB="$(lsblk -ndo pkname "$ROOT")"
	fi

	chboot_cp_root_files || panic "Error copying files to root filesystem"
	chboot_bind_mounts || panic "Unable to do bind mounts"
	chboot_install_grub "$CHB_GRUB" || panic "Error installing grub"
	urc=0
	chboot_manage_users || urc=$?
	if [ $rc -ne 0 ] ; then
		echo "Exit status: $urc"
		panic "Error updating user and group information"
	fi
	chboot_umount_all || true
	sync
	REBOOT_DELAY=10
	echo "All done!"
	while [ $REBOOT_DELAY -gt 0 ] ; do
		echo " Rebooting in $REBOOT_DELAY seconds"
		sleep 1
		REBOOT_DELAY=$(( $REBOOT_DELAY -1))
	done
	chboot_reboot

}

local_mount_fs()
{
	read_fstab_entry "$1"

	local_device_setup "$MNT_FSNAME" "$1 file system"
	MNT_FSNAME="${DEV}"

	chboot_premount

	if [ "${readonly}" = "y" ]; then
		roflag=-r
	else
		roflag=-w
	fi

	if [ "$MNT_PASS" != 0 ]; then
		checkfs "$MNT_FSNAME" "$MNT_DIR" "${MNT_TYPE}"
	fi

	# Mount filesystem
	if ! mount ${roflag} -t "${MNT_TYPE}" -o "${MNT_OPTS}" "$MNT_FSNAME" "${rootmnt}${MNT_DIR}"; then
		panic "Failed to mount ${MNT_FSNAME} as $MNT_DIR file system."
	fi
}

mountroot()
{
	chboot_mount_root
}

mount_top()
{
	# Note, also called directly in case it's overridden.
	local_top
}

mount_premount()
{
	# Note, also called directly in case it's overridden.
	chboot_premount
}

mount_bottom()
{
	# Note, also called directly in case it's overridden.
	chboot_bottom
}

_not_empty_dir(){
	rc=1
	TDIR="$1"
	if [ "$TDIR" ] && [ -d "$TDIR" ] && ls -1 ${TDIR} 2>/dev/null |grep -q "." ; then
		rc=0
	fi
	return $rc
}

_get_local_ids(){
        ID_MIN="$1"
        ID_MAX="$2"
        ID_FILE="$3"
        ID_MIN="$ID_MIN" ID_MAX="$ID_MAX" awk -F: '$3>=ENVIRON["ID_MIN"] && $3<=ENVIRON["ID_MAX"] {print $0}' "$ID_FILE"
}               
                        
_get_local_users(){
	FILE="$rootmnt/etc/passwd"
	[ -z "$1" ] || FILE="$1"    
        _get_local_ids $UID_MIN $UID_MAX $FILE
}                       
                        
_get_local_groups(){     
	FILE="$rootmnt/etc/group"
	[ -z "$1" ] || FILE="$1"    
        _get_local_ids $GID_MIN $GID_MAX $FILE
}                               

_get_field(){
	DATA="$1"
	NUMFIELD="$2"
	echo "$DATA" |cut -f $NUMFIELD -d ":"
}

_replace_line_for(){
	NAME="$1"
	TARGET_FILE="$2"
	SOURCE_FILE="$3"
	# remove line in the first file ONLY if NAME is present in BOTH files
	rc=0
	for f in "$SOURCE_FILE" "$TARGET_FILE" ; do
		grep -q "^${NAME}:" "$f" || rc=1
	done
	if [ $rc -eq 0 ] ; then
		sed -i -e "/^${NAME}:/d" "$TARGET_FILE"
		# add line from second file
		grep "^${NAME}:" "$SOURCE_FILE" >> "$TARGET_FILE"
	fi
	return 0
}

chboot_manage_users(){
	rc=0
	SOURCE_DIR="${chbmnt}/${CHB_DIR}/${CHB_DATA_DIR}/saved-users"
	SOURCE_FILE="${SOURCE_DIR}/users.cfg"
	if [ ! -r "$SOURCE_FILE" ] || [ ! -s "$SOURCE_FILE" ] ; then
		return 0
	fi

	# TODO: consider risks of sourcing an script file in chboot partition and 
	#       use an alternative method to parse data
	. $SOURCE_FILE

	# TODO: manage alternative modes, at this moment, only 'saved-users' mode is supported
	[ "$LOCAL_USERS_MODE" = "saved-users" ] || return 0

	# check variables
	for v in "$$UID_MIN" "$UID_MAX" "$GID_MIN" "$GID_MAX" ; do
		[ "$v" ] || return 10
	done  

	# check required files or return error
	for f in $USER_FILE $SHADOW_FILE $GROUP_FILE $GSHADOW_FILE $USER_SYSGROUPS ; do
		F="$SOURCE_DIR/$f"
		if [ -z "$f" ] || [ ! -r "$F" ] || [ ! -s "$F" ] ; then
			return 20
		fi
	done
	# 1 remove ALL non system users from chroot (to ensure we can preserve UIDs)
	rc=0
	for UDATA in $(_get_local_users) ; do
		u="$(_get_field "$UDATA" 1)"
		# use 'deluser' to remove user from groups and home deirectory
		chroot "$rootmnt" deluser --remove-home "$u" || rc=$?
	done
	[ $rc -eq 0 ] || return 1
	# 2 remove ALL non system groups from chroot (to ensure we can preserve GIDs)
	for GDATA in $(_get_local_groups) ; do
		g="$(_get_field "$GDATA" 1)"
		# use 'delgroup'
		chroot "$rootmnt" delgroup "$g" || rc=$?
	done
	[ $rc -eq 0 ] || return 2

	# 3 'insert' local groups including gshadow data
	for f in ${GROUP_FILE} ${GSHADOW_FILE} ; do
		cat "${SOURCE_DIR}/${f}" >> "${rootmnt}/etc/${f}"
	done
	
	# 4 create local users, 5 add to system groups and 6 replace lines in /etc/passwd and /etc/shadow to mantain passwords and user settings
	# Use useradd to ensure home dir creation and copy of /etc/skel files
	while IFS=":" read u_name dummy1 u_id u_gid u_gecos u_home u_shell ; do
		# 4 include minimal set of parameters to create home and avoid new UID or GID creation
		chroot "$rootmnt" useradd -D -m -N -u "$u_id" -d "$u_home" -g "$u_gid" "$u_name" || return 4
		# 5 iterate over system groups for the user, verify the group exists and then, add user to that group
		for g in $(grep "^${u_name}:" "${SOURCE_DIR}/${USER_SYSGROUPS}" |tr ":" "\n" |tail -n +2) ; do
			if grep -q "^${g}:" "${rootmnt}/etc/group" ; then
				chroot "$rootmnt" adduser "$u_name" "$g" || return 5
			fi
		done
		# 6 finally, replace lines lines in passwd and shadow to override passwords an other settings
		for f in ${USER_FILE} ${SHADOW_FILE} ; do
			_replace_line_for "$u_name" "${rootmnt}/etc/${f}" "${SOURCE_DIR}/${f}" || return 6
		done
	done < "${SOURCE_DIR}/${USER_FILE}"
	# 7 replace required 'specials' users passwords
	if [ "$SPECIAL_USERS" ] ; then
		f="$${SHADOW_FILE}"
		for u_name in $SPECIAL_USERS ; do
			_replace_line_for "$u_name" "${rootmnt}/etc/${f}" "${SOURCE_DIR}/${f}" || return 7
       		done
	fi

	return 0
}

chboot_cp_root_files(){
	rc=0
	SOURCE_DIR="${chbmnt}/${CHB_DIR}/${CHB_DATA_DIR}/saved-files"
	if _not_empty_dir "${SOURCE_DIR}" ; then
		# TODO: find a better way to do this ...
		CUR_DIR="$(pwd)"
		cd ${SOURCE_DIR}
		cp -a ./ /${rootmnt}/ || rc=$?
		cd "$CUR_DIR"
	else
		rc=0
	fi
	return $rc
}

chboot_bind_mounts(){
	EFIVARS_DIR="/sys/firmware/efi/efivars"
	# test if efivarfs is already mounted
	_not_empty_dir "${EFIVARS_DIR}" || mount -t efivarfs none $EFIVARS_DIR || return 1

	rc=0
	# do bind mounts
	for d in /dev /dev/pts /proc /sys /run /boot/efi $EFIVARS_DIR ; do mount --bind $d ${rootmnt}${d} || rc=2; done
	return $rc
}

chboot_umount_all(){
	# umount bind  and root dir
	EFIVARS_DIR="/sys/firmware/efi/efivars"
	if [ $rc -eq 0 ] ; then
		for d in $EFIVARS_DIR /boot/efi /run /sys /proc /dev/pts /dev ; do umount ${rootmnt}${d}; done  
		umount ${rootmnt}
	fi
}

chboot_install_grub(){
	DEST_DISK="$1"

	# install and update grub in chroot
	[ $rc -ne 0 ] || chroot "${rootmnt}" grub-install $DEST_DISK || rc=3
	[ $rc -ne 0 ] || chroot "${rootmnt}" update-grub || rc=4

	return $rc
}

